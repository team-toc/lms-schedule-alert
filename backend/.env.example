PORT=4000
# production이면 쿠키에 Secure가 붙는다
NODE_ENV=
LOG_LEVEL=
# nginx 같은 리버스 프록시 뒤에서 실행할 때 true (개발: false, 운영: true)
# 운영(Secure 쿠키)인데 false면 프록시 뒤에서 세션 쿠키가 발급되지 않는다
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=lms_schedule_alert
# npm test가 쓰는 DB. 개발 DB와 다른 이름이고 _test로 끝나야 한다
TEST_DB_NAME=lms_schedule_alert_test

# 32자 이상. 예: openssl rand -hex 32
SESSION_SECRET=
# 세션 유지 기간(일). 요청이 있을 때마다 연장된다. 비우면 7
SESSION_TTL_DAYS=
# 로그인 후 돌아갈 프론트 주소. 예: http://localhost:5173
FRONTEND_URL=

# 이메일 로그인 실패 횟수 제한 (같은 이메일 + IP 기준). 비우면 5회 · 15분
# LOGIN_LOCK_MINUTES는 "실패를 세는 기간이자 잠금 시간"이다:
# 첫 실패부터 이 시간 안에 LOGIN_MAX_FAILURES번 실패하면 그때부터 이 시간만큼 429로 잠근다
LOGIN_MAX_FAILURES=
LOGIN_LOCK_MINUTES=

KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 카카오 콘솔에 등록한 값과 같아야 한다. 예: http://localhost:4000/api/auth/kakao/callback
KAKAO_REDIRECT_URI=

# Google Cloud 콘솔 > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID (웹 애플리케이션)
# 예: 1234567890-abc123.apps.googleusercontent.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 콘솔의 "승인된 리디렉션 URI"와 정확히 같아야 한다. 예: http://localhost:4000/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# 학교 Canvas 주소 (경로 없이). 운영은 https만. 예: https://canvas.example.ac.kr
CANVAS_BASE_URL=
# Canvas 토큰 암호화 키: 32바이트를 base64로. 예: openssl rand -base64 32
# 잃어버리면 저장된 Canvas 토큰을 복구할 수 없다(사용자가 다시 등록해야 함). 서버마다 따로 안전하게 보관
CANVAS_TOKEN_KEY=
# Canvas 주기 동기화 간격(분). 비우면 30
LMS_SYNC_INTERVAL_MINUTES=
