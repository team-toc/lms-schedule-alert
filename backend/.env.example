PORT=4000
# production이면 쿠키에 Secure가 붙는다
NODE_ENV=
LOG_LEVEL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=lms_schedule_alert
# npm test가 쓰는 DB. 개발 DB와 다른 이름이어야 한다
TEST_DB_NAME=lms_schedule_alert_test

# 32자 이상. 예: openssl rand -hex 32
SESSION_SECRET=
# 로그인 후 돌아갈 주소이자 CORS 허용 출처. 예: http://localhost:5173
FRONTEND_URL=

KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 카카오 콘솔에 등록한 값과 같아야 한다. 예: http://localhost:4000/api/auth/kakao/callback
KAKAO_REDIRECT_URI=
