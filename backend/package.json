{
  "name": "lms-schedule-alert-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:status": "node scripts/migrate.js status",
    "test": "TZ=UTC node --test --test-concurrency=1 --test-timeout=30000 --test-force-exit \"test/**/*.test.js\"",
    "test:db:reset": "node scripts/reset-test-db.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.19.0",
    "mysql2": "^3.24.6",
    "node-ical": "0.27.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "umzug": "^3.8.3",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "express-mysql-session": {
      "mysql2": "$mysql2"
    },
    "rrule-temporal": "2.2.8",
    "temporal-polyfill": "1.0.6",
    "temporal-spec": "1.0.1",
    "temporal-utils": "1.0.3",
    "web-push": {
      ".": "3.6.7",
      "agent-base": "7.1.4",
      "asn1.js": "5.4.1",
      "bn.js": "4.12.5",
      "buffer-equal-constant-time": "1.0.1",
      "debug": "4.4.3",
      "ecdsa-sig-formatter": "1.0.11",
      "http_ece": "1.2.0",
      "https-proxy-agent": "7.0.6",
      "inherits": "2.0.4",
      "jwa": "2.0.1",
      "jws": "4.0.1",
      "minimalistic-assert": "1.0.1",
      "minimist": "1.2.8",
      "ms": "2.1.3",
      "safe-buffer": "5.2.1",
      "safer-buffer": "2.1.2"
    }
  }
}
